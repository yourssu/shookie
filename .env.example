# Exa public web search (optional). Set new GitHub Secret EXA_API_KEY for deployment.
# Empty disables web_search; web_fetch needs no key.
EXA_API_KEY=

# Slack
# Socket Mode bot/app credentials. Do not commit real values.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Socket Mode does not consume SLACK_SIGNING_SECRET. Add it only if an HTTP
# Slack event/action receiver is implemented and verifies Slack signatures.

# User OAuth for mention-group message replacement (optional)
# Deployment source: GitHub Variables for flags/URLs/numbers, GitHub Secrets
# for the client credentials and encryption key.
SLACK_USER_OAUTH_ENABLED=false
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=https://shookie.example.com/slack/user-oauth/callback
# 32 random bytes encoded as base64: openssl rand -base64 32
SLACK_TOKEN_ENCRYPTION_KEY=
# Must match the Token Rotation setting in the Slack app
SLACK_TOKEN_ROTATION_ENABLED=false
SLACK_USER_OAUTH_PORT=3000
# One-time state lifetime in seconds (60-900)
# State is random, SHA-256 hashed, stored in PostgreSQL, and consumed once;
# there is intentionally no separate SLACK_OAUTH_STATE_SECRET.
SLACK_OAUTH_STATE_TTL_SECONDS=600

# Radar mention-group replacement (optional; requires User OAuth above)
# Keep this false until the Slack/Radar manual gates in the rollout runbook pass.
SLACK_MENTION_GROUP_REPLACEMENT_ENABLED=false
RADAR_MENTION_GROUPS_API_URL=https://radar.example.com/internal/v1/mention-groups
SHOOKIE_MENTION_GROUPS_API_KEY=
RADAR_MENTION_GROUPS_CACHE_TTL_SECONDS=30
RADAR_MENTION_GROUPS_REQUEST_TIMEOUT_MS=10000

# Slack /group command (optional; uses Radar's separate write key)
# Syntax: /group <handle> <@member> [@member ...]
SLACK_MENTION_GROUP_COMMAND_ENABLED=false
RADAR_MENTION_GROUPS_WRITE_API_URL=http://localhost:8080/internal/v1/mention-groups
SHOOKIE_MENTION_GROUPS_WRITE_API_KEY=

# Slack event attendance reaction sync (optional)
# Forwards mapped reactions to Radar. Radar stores attendance and validates event links.
# Upload the matching emoji assets from shookie/assets/event-emojis to Slack.
SLACK_EVENT_ATTENDANCE_ENABLED=false
SLACK_EVENT_ATTENDING_EMOJI=shookie_attend
SLACK_EVENT_ABSENT_EMOJI=shookie_absent
SLACK_EVENT_AFTERPARTY_EMOJI=shookie_afterparty
RADAR_EVENT_ATTENDANCE_WRITE_API_URL=http://localhost:8080/internal/v1/events/slack-reactions
SHOOKIE_EVENT_ATTENDANCE_WRITE_API_KEY=
# Radar's RADAR_EVENT_ATTENDANCE_INTERNAL_WRITE_API_KEY must use this same value.
RADAR_EVENT_ATTENDANCE_REQUEST_TIMEOUT_MS=10000

# Radar meeting reminders (optional; both values enable 60-second polling)
# Native local bot: http://localhost:8080/internal/v1/meeting-reminders
# Container/production bot: use an HTTPS Radar URL reachable from the bot.
# GitHub explorer: registry URL + key are always required (never org-wide fallback).
# All three App fields blank: legacy GITHUB PAT migration fallback only. Partial/App failure denies.
# App-only setup works with GITHUB empty; do not reuse Radar's existing GITHUB_APP_* keys.
GITHUB_OWNER=yourssu
# Dedicated organization read-only App; IDs are Actions variables, base64 PEM is a secret.
SHOOKIE_GITHUB_APP_ID=
SHOOKIE_GITHUB_APP_INSTALLATION_ID=
SHOOKIE_GITHUB_APP_PRIVATE_KEY_BASE64=
RADAR_GITHUB_REGISTRY_API_URL=
SHOOKIE_GITHUB_REGISTRY_INTERNAL_API_KEY=
# Full HTTPS endpoint: /internal/v1/shookie/github/repositories; dedicated shared secret provisioned externally.
RADAR_MEETING_REMINDER_API_URL=
SHOOKIE_MEETING_REMINDER_INTERNAL_API_KEY=
# Must match Radar's RADAR_MEETING_REMINDER_INTERNAL_API_KEY.

# Radar Slack message relay (optional; OFF by default). Deploy the Radar backend first.
# Public-channel message METADATA only (no text/files) is stored in a PostgreSQL outbox before Slack is
# acknowledged, then delivered by a separate bounded drain. See docs/slack-message-relay.md.
RADAR_SLACK_RELAY_ENABLED=false
# Native local bot: http://localhost:8080/internal/v1/slack/message-events (HTTPS otherwise)
RADAR_SLACK_RELAY_URL=
# Authenticated Socket Mode app / workspace; events whose envelope differs are NOT relayed.
RADAR_SLACK_RELAY_APP_ID=
RADAR_SLACK_RELAY_TEAM_ID=
# Dedicated shared key: must equal Radar's RADAR_SLACK_RELAY_INTERNAL_API_KEY. Never reuse another key.
RADAR_SLACK_RELAY_INTERNAL_API_KEY=

# LLM (DeepSeek)
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# PostHog (optional). The subagent needs POSTHOG_API_KEY AND the Radar project registry.
# Radar is the sole source of allowed projects/guidance; both registry values blank disables PostHog
# (no code-whitelist fallback). Partial/malformed values fail startup.
POSTHOG_API_KEY=phx_...
# Full endpoint: https://<Radar host>/internal/v1/shookie/posthog/projects (http only for localhost/127.0.0.1)
RADAR_POSTHOG_REGISTRY_API_URL=
# Dedicated shared key (16-512 non-whitespace chars) provisioned externally; never reuse another key.
SHOOKIE_POSTHOG_REGISTRY_INTERNAL_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shookie
POSTGRES_PASSWORD=postgres

# Logging
LOG_LEVEL=info
MAX_TOOL_ITERATIONS=8
